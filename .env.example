# Copy to .env.local and fill in. .env.local is never committed.

# Signs sign-in sessions. Make a fresh random one per install, for example:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the site runs.
BETTER_AUTH_URL=http://localhost:3000

# Optional: where the SQLite database file lives. Defaults to data/bass-hero.db.
# BASS_HERO_DB_PATH=data/bass-hero.db
